# azure-rd-docs-web — environment variables
#
# Configuration is environment variables only: there is no config file, and this
# file is NOT loaded by the app (no dotenv, no new configuration mechanism). It is
# a reference you copy and source into your own shell, so every variable the
# browser reads is documented in one place:
#
#   cp .env.example .env
#   set -a; source .env; set +a
#   npm run start:prod
#
# Every variable below is optional: with none of them set the defaults shown
# apply. Each value here IS the built-in default, so sourcing this file unchanged
# behaves exactly like starting the server with an empty environment.

# Root that is scanned for tenant folders, up to 3 levels deep. A directory
# counts as a tenant when it holds a readable, parseable `docs/index.yaml`.
# Relative values are resolved against the process working directory, which is
# this folder — the default therefore points at the export tree at the repo root.
DOCS_ROOT=../output

# HTTP listen port.
PORT=3000

# --- Not implemented yet ------------------------------------------------------
# Listed because it is the one planned variable (see NEXT-ITERATIONS.md); the
# server ignores it today.
#
# Which index the Confluence export writes onto `Overview.html`:
#   type  the by-type Pages list only — today's export, byte for byte (default)
#   both  that list, then one collapsible section per taxonomy axis
#   axis  the axis sections only, no by-type list
# The axis view is opt-in: an unknown or empty value falls back to `type`, so a
# typo can neither fail the export nor change what it contains. Axis sections need
# a taxonomy in `docs/index.yaml`; without one, `axis` and `both` produce the
# by-type list alone.
#EXPORT_INDEX=type
