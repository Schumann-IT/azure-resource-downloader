{
  "name": "azure-rd-docs-web",
  "version": "0.1.0",
  "description": "Iteration 1 documentation browser for azure-resource-downloader exports.",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "css:build": "tailwindcss -i ./src/styles.css -o ./public/app.css --minify",
    "css:watch": "tailwindcss -i ./src/styles.css -o ./public/app.css --watch",
    "prebuild": "rimraf dist",
    "build": "npm run css:build && nest build",
    "start": "node dist/main.js",
    "start:dev": "npm run css:build && concurrently -k \"npm:css:watch\" \"nest start --watch\"",
    "start:prod": "npm run build && node dist/main.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "gray-matter": "^4.0.3",
    "hbs": "^4.2.0",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "shiki": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@tailwindcss/cli": "^4.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.1.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "fsevents@2.3.3": true
  }
}
