{
  "name": "azure-rd-docs-web",
  "version": "0.3.0",
  "description": "Read-only documentation browser and Confluence exporter for azure-resource-downloader tenant exports.",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "css:build": "tailwindcss -i ./src/styles.css -o ./public/app.css --minify",
    "css:watch": "tailwindcss -i ./src/styles.css -o ./public/app.css --watch",
    "prebuild": "rimraf dist",
    "build": "npm run css:build && nest build",
    "start": "node dist/main.js",
    "start:dev": "npm run css:build && concurrently -k \"npm:css:watch\" \"nest start --watch\"",
    "start:prod": "npm run build && node dist/main.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:baseline": "eslint . --suppress-all",
    "lint:prune": "eslint . --prune-suppressions",
    "start-item": "node scripts/start-item.js",
    "branch-ready": "node scripts/working-tree-clean.js && npm run test && npm run lint && npm run build && node scripts/branch-ready.js",
    "branch-ready:report": "node scripts/working-tree-clean.js && node scripts/branch-ready.js",
    "release-ready": "npm run test && npm run lint && npm run build && node scripts/release-ready.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-express": "^12.1.1",
    "diff": "^9.0.0",
    "gray-matter": "^4.0.3",
    "hbs": "^4.3.1",
    "htmlparser2": "^12.0.0",
    "js-yaml": "^5.4.2",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "pdfmake": "^0.3.11",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "shiki": "^4.4.3",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.1",
    "@tailwindcss/cli": "^4.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.6.3",
    "@types/pdfmake": "^0.3.3",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.0.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "yauzl": "^3.2.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "fsevents@2.3.3": true
  }
}
