<!doctype html>
<html lang="en">
  {{> head}}
  <body id="resource-page" class="bg-white text-slate-900 dark:bg-slate-950 dark:text-slate-100 antialiased">
    {{> header}}
    <div class="doc-layout mx-automax-w-(--breakpoint-2xl) px-4 py-8 flex flex-col-reverse gap-8 lg:flex-row">
      {{#if nav}}{{> sidebar nav}}{{/if}}
      <main class="doc-main min-w-0 flex-1">
        <p class="doc-source mb-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500 dark:text-slate-400">
          {{#if observed}}
          <span>observed payload <code class="font-mono">drift/{{source}}</code></span>
          {{else}}
          <span>exported source <code class="font-mono">resources/{{source}}</code></span>
          {{/if}}
          <span>·</span>
          <span>{{lines}} lines</span>
          <span>·</span>
          <span>{{size}} bytes</span>
          <span>·</span>
          <a href="{{rawHref}}" class="text-brand-600 dark:text-brand-400 hover:underline">raw</a>
        </p>
        {{#unless highlighted}}
          <p class="mb-4 rounded-lg border border-slate-200 dark:border-slate-700 px-3 py-2 text-xs text-slate-500 dark:text-slate-400">
            Shown unhighlighted — this file is too large to highlight.
          </p>
        {{/unless}}
        <div class="yaml-view min-w-0">
          {{{body}}}
        </div>
      </main>
    </div>
  </body>
</html>
