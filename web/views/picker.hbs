<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}}</title>
    <link rel="stylesheet" href="/app.css" />
  </head>
  <body class="bg-white text-slate-900 dark:bg-slate-950 dark:text-slate-100 antialiased">
    {{> header}}
    <main class="mx-auto max-w-5xl px-4 py-10">
      <h1 class="text-2xl font-bold mb-1">Tenant documentation</h1>
      <p class="text-slate-500 dark:text-slate-400 mb-6">Generated Azure / Entra ID / Intune configuration docs.</p>
      {{#if tenants.length}}
        <ul class="space-y-3">
          {{#each tenants}}
            <li>
              <a
                href="/{{this.id}}"
                class="block rounded-lg border border-slate-200 dark:border-slate-700 p-4 hover:border-brand-400 dark:hover:border-brand-400 transition"
              >
                <span class="text-lg font-semibold text-brand-600 dark:text-brand-400">{{this.id}}</span>
                <span class="block text-sm text-slate-500 dark:text-slate-400 mt-1">
                  {{this.documented}} documented{{#if this.pending}} · {{this.pending}} pending{{/if}}{{#if this.generatedAt}} · exported {{this.generatedAt}}{{/if}}
                </span>
              </a>
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="text-slate-500 dark:text-slate-400">
          No tenants found under the docs root. Set <code class="font-mono">DOCS_ROOT</code> to a folder
          containing export directories, each with a <code class="font-mono">docs/index.yaml</code>
          written by <code class="font-mono">azure-rd docs generate-index</code>.
        </p>
      {{/if}}
    </main>
  </body>
</html>
