<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}}</title>
    <link rel="stylesheet" href="/app.css" />
  </head>
  <body class="bg-white text-slate-900 dark:bg-slate-950 dark:text-slate-100 antialiased">
    {{> header}}
    <div class="mx-auto max-w-7xl px-4 py-8 flex flex-col-reverse gap-8 lg:flex-row">
      {{#if nav}}{{> sidebar nav}}{{/if}}
      <main class="min-w-0 flex-1">
        {{#if meta.source}}
          <p class="mb-4 text-xs text-slate-500 dark:text-slate-400">
            source
            {{#if sourceHref}}
              <a href="{{sourceHref}}" class="font-mono text-brand-600 dark:text-brand-400 hover:underline">{{meta.source}}</a>
            {{else}}
              <code class="font-mono">{{meta.source}}</code>
            {{/if}}{{#if meta.generatedAt}} · generated {{meta.generatedAt}}{{/if}}
          </p>
        {{/if}}
        <article class="prose prose-slate dark:prose-invert max-w-none">
          {{{body}}}
        </article>
      </main>
    </div>
  </body>
</html>
