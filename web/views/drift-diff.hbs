<!doctype html>
<html lang="en">
  {{> head}}
  <body id="drift-diff-page" class="bg-white text-slate-900 dark:bg-slate-950 dark:text-slate-100 antialiased">
    {{> header}}
    <div class="doc-layout mx-auto max-w-7xl px-4 py-8 flex flex-col-reverse gap-8 lg:flex-row">
      {{#if nav}}{{> sidebar nav}}{{/if}}
      <main class="doc-main min-w-0 flex-1">
        <p class="doc-source mb-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500 dark:text-slate-400">
          <span>baseline <code class="font-mono">resources/{{baselineSource}}</code></span>
          <span>→</span>
          <span>observed <code class="font-mono">drift/{{observedSource}}</code></span>
          {{#unless diff.tooLarge}}
            <span>·</span>
            <span class="text-emerald-700 dark:text-emerald-300">+{{diff.added}}</span>
            <span class="text-red-700 dark:text-red-300">−{{diff.removed}}</span>
          {{/unless}}
          <span>·</span>
          <a href="{{baselineRawHref}}" class="text-brand-600 dark:text-brand-400 hover:underline">baseline raw</a>
          <a href="{{observedRawHref}}" class="text-brand-600 dark:text-brand-400 hover:underline">observed raw</a>
          <span>·</span>
          <a href="{{findingHref}}" class="text-brand-600 dark:text-brand-400 hover:underline">finding</a>
        </p>

        {{#if diff.tooLarge}}
          <p class="drift-diff-too-large rounded-lg border border-slate-200 dark:border-slate-700 px-3 py-2 text-sm text-slate-500 dark:text-slate-400">
            These files are too large to diff here — compare the raw files instead.
          </p>
        {{else if diff.hunks.length}}
          <div class="drift-diff overflow-x-auto rounded-lg border border-slate-200 dark:border-slate-700">
            <table class="w-full border-collapse font-mono text-xs">
              {{#each diff.hunks}}
                <tbody>
                  <tr class="bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">
                    <td colspan="4" class="px-3 py-1">{{this.header}}</td>
                  </tr>
                  {{#each this.lines}}
                    {{#if this.added}}
                      <tr class="diff-added bg-emerald-50 dark:bg-emerald-950/40">
                        <td class="w-10 select-none px-2 text-right text-slate-400 dark:text-slate-500"></td>
                        <td class="w-10 select-none px-2 text-right text-slate-400 dark:text-slate-500">{{this.newNo}}</td>
                        <td class="w-4 select-none text-emerald-700 dark:text-emerald-300">+</td>
                        <td class="whitespace-pre pr-3 text-emerald-900 dark:text-emerald-200">{{this.text}}</td>
                      </tr>
                    {{else if this.removed}}
                      <tr class="diff-removed bg-red-50 dark:bg-red-950/40">
                        <td class="w-10 select-none px-2 text-right text-slate-400 dark:text-slate-500">{{this.oldNo}}</td>
                        <td class="w-10 select-none px-2 text-right text-slate-400 dark:text-slate-500"></td>
                        <td class="w-4 select-none text-red-700 dark:text-red-300">−</td>
                        <td class="whitespace-pre pr-3 text-red-900 dark:text-red-200">{{this.text}}</td>
                      </tr>
                    {{else}}
                      <tr class="diff-context">
                        <td class="w-10 select-none px-2 text-right text-slate-400 dark:text-slate-500">{{this.oldNo}}</td>
                        <td class="w-10 select-none px-2 text-right text-slate-400 dark:text-slate-500">{{this.newNo}}</td>
                        <td class="w-4 select-none"></td>
                        <td class="whitespace-pre pr-3 text-slate-700 dark:text-slate-300">{{this.text}}</td>
                      </tr>
                    {{/if}}
                  {{/each}}
                </tbody>
              {{/each}}
            </table>
          </div>
        {{else}}
          <p class="drift-diff-identical text-sm text-slate-500 dark:text-slate-400">
            The two files are identical line for line; the finding comes from the recorded comparison, not from these bytes.
          </p>
        {{/if}}
      </main>
    </div>
  </body>
</html>
