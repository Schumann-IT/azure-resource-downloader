<!doctype html>
<html lang="en">
  {{> head}}
  <body id="drift-diff-page" class="bg-white text-slate-900 dark:bg-slate-950 dark:text-slate-100 antialiased">
    {{> header}}
    <div class="doc-layout mx-automax-w-(--breakpoint-2xl) px-4 py-8 flex flex-col-reverse gap-8 lg:flex-row">
      {{#if nav}}{{> sidebar nav}}{{/if}}
      <main class="doc-main min-w-0 flex-1">
        <p class="doc-source mb-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500 dark:text-slate-400">
          <span>baseline <code class="font-mono">resources/{{baselineSource}}</code></span>
          <span>→</span>
          <span>observed <code class="font-mono">drift/{{observedSource}}</code></span>
          {{#unless diff.tooLarge}}
            <span>·</span>
            <span class="text-emerald-700 dark:text-emerald-300">+{{diff.added}}</span>
            <span class="text-red-700 dark:text-red-300">−{{diff.removed}}</span>
            {{#if diff.changes}}
              <a href="#change-1" class="diff-changes text-brand-600 dark:text-brand-400 hover:underline">{{diff.changesLabel}}</a>
            {{/if}}
          {{/unless}}
          <span>·</span>
          <a href="{{baselineRawHref}}" class="text-brand-600 dark:text-brand-400 hover:underline">baseline raw</a>
          <a href="{{observedRawHref}}" class="text-brand-600 dark:text-brand-400 hover:underline">observed raw</a>
          <span>·</span>
          <a href="{{findingHref}}" class="text-brand-600 dark:text-brand-400 hover:underline">finding</a>
        </p>

        {{#if diff.tooLarge}}
          <p class="drift-diff-too-large rounded-lg border border-slate-200 dark:border-slate-700 px-3 py-2 text-sm text-slate-500 dark:text-slate-400">
            These files are too large to diff here — compare the raw files instead.
          </p>
        {{else if diff.hunks.length}}
          {{> diff_table hunks=diff.hunks left="baseline" right="observed"}}
        {{else}}
          <p class="drift-diff-identical text-sm text-slate-500 dark:text-slate-400">
            The two files are identical line for line; the finding comes from the recorded comparison, not from these bytes.
          </p>
        {{/if}}
      </main>
    </div>
  </body>
</html>
