<header class="site-header border-b border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-900/80 backdrop-blur sticky top-0 z-10">
  {{!-- The row's width is the page's: it defaults to the document/tenant/resource
        layout and the narrow pages (picker, error) pass their own, so the
        breadcrumb always lines up with what is under it. --}}
  <div class="mx-auto {{#if headerWidth}}{{headerWidth}}{{else}}max-w-7xl{{/if}} px-4 py-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
    <a href="/" class="font-semibold text-brand-600 dark:text-brand-400 hover:underline">Docs</a>
    {{#if tenant}}
      <span class="text-slate-400">/</span>
      <a href="/{{tenant}}" class="text-slate-700 dark:text-slate-200 hover:underline">{{tenant}}</a>
    {{/if}}
    {{#each breadcrumb}}
      <span class="text-slate-400">/</span>
      <span class="text-slate-500 dark:text-slate-400">{{this.label}}</span>
    {{/each}}
    {{#if views}}
      <nav class="view-switcher ml-auto flex items-center gap-1 text-xs" aria-label="Representation">
        {{!-- An entry without an href is inert: it is shown, so its absence is
              never ambiguous, and its title says why there is nothing behind it. --}}
        {{#each views}}
          {{#if this.href}}
          <a
            href="{{this.href}}"
            {{#if this.active}}aria-current="page"{{/if}}
            {{#if this.reason}}title="{{this.reason}}"{{/if}}
            class="rounded px-2 py-1 {{#if this.active}}bg-slate-100 dark:bg-slate-800 font-medium text-slate-900 dark:text-slate-100{{else}}text-slate-500 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400{{/if}}"
          >{{this.label}}</a>
          {{else}}
          <span aria-disabled="true" title="{{this.reason}}" class="rounded px-2 py-1 cursor-not-allowed text-slate-300 dark:text-slate-600">{{this.label}}</span>
          {{/if}}
        {{/each}}
      </nav>
    {{/if}}
  </div>
</header>
