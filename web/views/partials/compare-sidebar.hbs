<aside aria-label="Comparison navigation" class="nav-tree w-full lg:w-80 lg:shrink-0 lg:sticky lg:top-14 lg:self-start lg:max-h-[calc(100vh-4.5rem)] lg:overflow-y-auto lg:pr-2">
  <a href="{{listingHref}}" class="block text-base font-semibold hover:underline">{{left.id}} <span class="text-slate-400">↔</span> {{right.id}}</a>
  <p class="compare-sidebar-totals mt-1 text-xs text-slate-500 dark:text-slate-400">
    {{totals.both}} in both · {{totals.onlyA}} only in {{left.id}} · {{totals.onlyB}} only in {{right.id}}<br />
    <a href="{{swapHref}}" class="underline hover:text-brand-600 dark:hover:text-brand-400">swap sides</a>
  </p>

  {{> sidebar_facets}}

  {{> sidebar_tree}}
</aside>
