<span class="badge inline-block rounded px-1.5 py-0.5 text-xs font-medium {{#if danger}}bg-red-100 text-red-800 dark:bg-red-950/60 dark:text-red-300{{else if warning}}bg-amber-100 text-amber-900 dark:bg-amber-950/60 dark:text-amber-200{{else if success}}bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300{{else if info}}bg-sky-100 text-sky-800 dark:bg-sky-950/60 dark:text-sky-300{{else}}bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300{{/if}}">{{label}}</span>
